#!/usr/bin/env bash
# Start Thunderbird minimized (for Amadeus' mail bridge). Does nothing if it is already running.
pgrep -x thunderbird >/dev/null && exit 0
JS=~/.local/share/amadeus/kwin/minimize-thunderbird.js
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript amadeus-min-tb >/dev/null 2>&1
id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$JS" amadeus-min-tb 2>/dev/null) && \
  qdbus6 org.kde.KWin /Scripting/Script$id org.kde.kwin.Script.run >/dev/null 2>&1
setsid -f thunderbird >/dev/null 2>&1
# stop watching after a minute so windows you open later are not touched
( sleep 60; qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript amadeus-min-tb >/dev/null 2>&1 ) &
