[Unit]
Description=Amadeus speech normalization (numbers, dates, units in words before reading aloud; NeMo, CPU)
After=network.target
# optional (speech falls back to its own rules): a broken setup stops after 5 tries instead of restarting forever
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStart=%h/.local/share/amadeus/voice/venv-tn/bin/python -W ignore @REPO@/core/voice/normalize_server.py
Restart=on-failure
RestartSec=10
Nice=5
Environment=OMP_NUM_THREADS=2

[Install]
WantedBy=default.target
