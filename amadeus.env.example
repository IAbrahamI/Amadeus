# Copy to amadeus.env and adjust. install.sh reads it automatically. All values are optional.

# Local LLM (Ollama)
# Normally picked during the install (speed test and three suggestions). Set these to skip that.
#OLLAMA_MODEL=qwen3.5:9b
#OLLAMA_CTX_VARIANT=qwen3.5-9b-48k
#OLLAMA_NUM_CTX=49152
#OLLAMA_URL=http://127.0.0.1:11434

# Memory (Hindsight)
#HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:0.10.2
#HINDSIGHT_CONTAINER=hindsight
#HINDSIGHT_VOLUME=hindsight-data
#HINDSIGHT_LLM_MODEL=qwen3.5-9b-48k
#HINDSIGHT_WORKER_ID=amadeus-hindsight

# The first ./install.sh asks for these two and writes them here; ./install.sh --setup asks again.
# Your folder, with Notes/ and Projects/ in it. Asked during the install; suggestion ~/Amadeus.
#AMADEUS_FOLDER="/absolute/path/to/your/folder"
# Voice: speech recognition and the wake word (1 = set up). Mail needs nothing here: connect accounts on the Mail page.
#AMADEUS_VOICE=1
# The web: your own search engine (SearXNG) in a container, so it can look things up (1 = set up)
#AMADEUS_WEB=1

# Set to 1 to skip prompts and accept onboarding defaults
#ASSUME_YES=0
